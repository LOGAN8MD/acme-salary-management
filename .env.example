# Copy to .env in the repository root. Do not commit .env.
PORT=3001
HOST=127.0.0.1
# Number of trusted reverse proxies. Keep 0 locally; the supplied Render service uses 1.
TRUST_PROXY_HOPS=0
# Vite uses this only in development; browser requests stay same-origin.
API_PROXY_TARGET=http://127.0.0.1:3001

# Local development only; replace credentials/host for a managed deployment.
DATABASE_URL=postgresql://acme:acme_local_only@127.0.0.1:55432/acme

# Synthetic local demo account only. Set a private value for a hosted demo.
SEED_HR_PASSWORD=AcmeLocalDemo2026!

# Exact browser origin used for CSRF verification; HTTPS required in production.
APP_ORIGIN=http://127.0.0.1:5173
